{
  "manifest_version": 3,
  "name": "Environment Switcher",
  "version": "1.3.1",
  "description": "Open a page on DEV / UAT / PRD: after Preview or Publish in DA, and from the original site via the toolbar icon.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "webRequest",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://da.live/*",
    "https://*.aem.page/*",
    "https://*.aem.live/*"
  ],
  "action": {
    "default_title": "Environment Switcher",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
